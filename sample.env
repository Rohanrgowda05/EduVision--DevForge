# Database Configuration (Neon Postgres)
DATABASE_URL=postgresql://neondb_owner:password@ep-example-pooler.c-8.us-east-1.aws.neon.tech/neondb?sslmode=require

# Session Configuration
SESSION_SECRET=your-secret-key-here-change-this-in-production

# Node Environment
NODE_ENV=development
PORT=3000

# YouTube Data API v3 Key (Server-side search with 24h caching)
YOUTUBE_API_KEY=your-youtube-api-key

# Gemini API Key (required for notes generation and quiz)
GEMINI_API_KEY=your-gemini-api-key

# Clerk Authentication (Phase 2)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key

# Flask Microservice & Internal Communication (Phase 2)
FLASK_URL=http://127.0.0.1:5000
INTERNAL_AUTH_TOKEN=your-shared-internal-secret-token

# Concurrency & Job Limits (Phase 2)
RENDER_CONCURRENCY=1
DAILY_JOB_CAP=10
